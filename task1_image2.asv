%% TASK 1 - IMAGE 2
clc;
clear;
close all;

I = imread('MakeUsGolden.jpg');
I_double = im2double(I);
[rows, cols, ~] = size(I);

components = detectThreeSkinComponentsAuto(I);

maskLeft   = segmentPersonFromSkinAuto(I, components(1).Mask, components(1).BBox, 1);
maskCenter = segmentPersonFromSkinAuto(I, components(2).Mask, components(2).BBox, 2);
maskRight  = segmentPersonFromSkinAuto(I, components(3).Mask, components(3).BBox, 3);

finalMask = maskLeft | maskCenter | maskRight;

finalMask = imfill(finalMask, 'holes');
finalMask = bwareaopen(finalMask, 1500);
finalMask = imclose(finalMask, strel('disk', 4));
finalMask = imopen(finalMask, strel('disk', 1));

featherMask = imgaussfilt(double(finalMask), 0.9);

maskRGB = repmat(finalMask, [1 1 3]);
I_detected = I;
I_detected(~maskRGB) = 0;

I_gold = I_double;

goldR = min(I_double(:,:,1) .* (1 + 0.16 .* featherMask) + 0.10 .* featherMask, 1);
goldG = min(I_double(:,:,2) .* (1 + 0.08 .* featherMask) + 0.05 .* featherMask, 1);
goldB = max(I_double(:,:,3) .* (1 - 0.05 .* featherMask) - 0.01 .* featherMask, 0);

I_gold(:,:,1) = (1 - featherMask).*I_double(:,:,1) + featherMask.*goldR;
I_gold(:,:,2) = (1 - featherMask).*I_double(:,:,2) + featherMask.*goldG;
I_gold(:,:,3) = (1 - featherMask).*I_double(:,:,3) + featherMask.*goldB;

mask_uint8 = uint8(finalMask) * 255;
I_gold_uint8 = im2uint8(I_gold);

figure('Name', 'TASK 1 - IMAGE 2', 'NumberTitle', 'off');

subplot(2,3,1);
imshow(I);
title('Original');

subplot(2,3,2);
imshow(maskLeft | maskCenter | maskRight);
title('Automatic Person Masks');

subplot(2,3,3);
imshow(finalMask);
title('Final People Mask');

subplot(2,3,4);
imshow(I_detected);
title('Detected People Only');

subplot(2,3,5);
imshow(mask_uint8);
title('Binary Mask');

subplot(2,3,6);
imshow(I_gold_uint8);
title('Golden People Only');

imwrite(I_detected, 'task1_img2_detected_people.jpg');
imwrite(mask_uint8, 'task1_img2_mask.jpg');
imwrite(I_gold_uint8, 'task1_img2_golden_people.jpg');

fprintf('==============================================\n');
fprintf('         PROJECT IN IMAGE PROCESSING\n');
fprintf('==============================================\n');
fprintf(' Task       : Task 1 - Image 2\n');
fprintf(' Process    : Automatic skin-based detection + GrabCut + recovery\n');
fprintf(' Output     : Completed successfully\n');
fprintf('==============================================\n');

%% ============================================================
%% LOCAL FUNCTIONS
%% ============================================================

function components = detectThreeSkinComponentsAuto(I)
    [rows, cols, ~] = size(I);

    YCbCr = rgb2ycbcr(I);
    Y  = YCbCr(:,:,1);
    Cb = YCbCr(:,:,2);
    Cr = YCbCr(:,:,3);

    skinMask = ...
        (Cb >= 77 & Cb <= 127) & ...
        (Cr >= 133 & Cr <= 173) & ...
        (Y  >= 60);

    regionMask = false(rows, cols);
    regionMask(round(rows*0.35):round(rows*0.95), :) = true;
    skinMask = skinMask & regionMask;

    skinMask = imopen(skinMask, strel('disk', 2));
    skinMask = imclose(skinMask, strel('disk', 3));
    skinMask = imfill(skinMask, 'holes');
    skinMask = bwareaopen(skinMask, 400);

    CC = bwconncomp(skinMask);
    stats = regionprops(CC, 'Area', 'BoundingBox', 'Centroid');

    if isempty(stats)
        error('Automatic skin detection failed. No candidate face regions found.');
    end

    areas = [stats.Area]';
    [~, idx] = sort(areas, 'descend');

    keep = [];
    for k = 1:numel(idx)
        bb = stats(idx(k)).BoundingBox;
        cx = stats(idx(k)).Centroid(1);
        cy = stats(idx(k)).Centroid(2);

        if bb(2) > rows*0.35 && bb(2) < rows*0.80 && ...
           bb(4) > rows*0.08 && bb(4) < rows*0.55 && ...
           cx > cols*0.05 && cx < cols*0.95 && ...
           cy > rows*0.40 && cy < rows*0.92
            keep(end+1) = idx(k); 
        end

        if numel(keep) >= 6
            break;
        end
    end

    if numel(keep) < 3
        error('Automatic skin detection did not find 3 strong foreground face regions.');
    end

    % From plausible set, keep the top 3 by area
    candidateAreas = areas(keep);
    [~, order2] = sort(candidateAreas, 'descend');
    keep = keep(order2(1:3));

    % Build output masks
    components = struct('Mask', {}, 'BBox', {}, 'Centroid', {});
    for i = 1:3
        m = false(rows, cols);
        m(CC.PixelIdxList{keep(i)}) = true;
        components(i).Mask = m;
        components(i).BBox = stats(keep(i)).BoundingBox;
        components(i).Centroid = stats(keep(i)).Centroid;
    end

    % Sort left-to-right
    xcent = zeros(1,3);
    for i = 1:3
        xcent(i) = components(i).Centroid(1);
    end
    [~, sortIdx] = sort(xcent, 'ascend');
    components = components(sortIdx);
end

function fullMask = segmentPersonFromSkinAuto(I, skinMaskGlobal, bbox, personIdx)
    [rows, cols, ~] = size(I);
    I_double = im2double(I);

    % Bounding box from automatic skin detection
    x = bbox(1);
    y = bbox(2);
    w = bbox(3);

    % Use bbox width as main scale
    wFace = max(w, 120);

    %% --------------------------------------------------------
    %% Person-specific automatic parameters
    switch personIdx
        case 1   % LEFT
            cropLeftMul   = 0.80;
            cropRightMul  = 1.55;
            cropTopMul    = 0.85;

            headRxMul     = 0.78;   % slimmer
            headRyMul     = 1.08;   % taller
            headCyMul     = 0.22;   % higher

            bodyRxMul     = 1.18;
            bodyRyMul     = 1.95;
            bodyCyMul     = 2.22;

            bridgeWMul    = 1.30;
            bridgeHMul    = 0.92;
            shoulderWMul  = 1.95;
            strapLeftMul  = 1.00;
            strapRightMul = 1.02;

        case 2   % CENTER
            cropLeftMul   = 0.95;
            cropRightMul  = 1.55;
            cropTopMul    = 0.82;

            headRxMul     = 0.95;
            headRyMul     = 1.10;
            headCyMul     = 0.26;

            bodyRxMul     = 1.34;
            bodyRyMul     = 2.00;
            bodyCyMul     = 2.26;

            bridgeWMul    = 1.45;
            bridgeHMul    = 0.95;
            shoulderWMul  = 2.05;
            strapLeftMul  = 0.00;
            strapRightMul = 0.00;

        case 3   % RIGHT
            cropLeftMul   = 1.05;
            cropRightMul  = 1.30;
            cropTopMul    = 0.85;

            headRxMul     = 0.76;   % slimmer
            headRyMul     = 1.06;   % taller
            headCyMul     = 0.21;   % higher

            bodyRxMul     = 1.16;
            bodyRyMul     = 1.92;
            bodyCyMul     = 2.20;

            bridgeWMul    = 1.28;
            bridgeHMul    = 0.92;
            shoulderWMul  = 1.90;
            strapLeftMul  = 0.00;
            strapRightMul = 0.98;
    end

    %% --------------------------------------------------------
    %% Automatic crop derived from detected skin region
    x1 = max(1, round(x - cropLeftMul*wFace));
    x2 = min(cols, round(x + w + cropRightMul*wFace));
    y1 = max(1, round(y - cropTopMul*wFace));
    y2 = rows;

    Icrop = I(y1:y2, x1:x2, :);
    IcropD = I_double(y1:y2, x1:x2, :);
    [hc, wc, ~] = size(Icrop);

    % Local skin seed
    skinLocal = skinMaskGlobal(y1:y2, x1:x2);

    % Local bbox of skin seed inside crop
    statsLocal = regionprops(skinLocal, 'BoundingBox', 'Centroid', 'Area');
    if isempty(statsLocal)
        error('Local skin seed disappeared after cropping.');
    end
    [~, biggestIdx] = max([statsLocal.Area]);
    bb = statsLocal(biggestIdx).BoundingBox;
    cx = statsLocal(biggestIdx).Centroid(1);

    % Use local bbox width as robust face scale
    wFace = max(bb(3), 120);

    %% --------------------------------------------------------
    %% Automatic hair detection above the skin region
    HSV = rgb2hsv(IcropD);
    H = HSV(:,:,1);
    S = HSV(:,:,2);
    V = HSV(:,:,3);

    hairSearch = rectMaskCenter(cx, bb(2) - 0.02*wFace, 1.40*wFace, 1.45*wFace, hc, wc);
    hairTopLimit = false(hc, wc);
    hairTopLimit(1:min(hc, round(bb(2) + 0.25*wFace)), :) = true;

    darkHair = (V < 0.45) & hairSearch & hairTopLimit;
    darkHair = darkHair & imdilate(skinLocal, strel('disk', 10));
    darkHair = bwareaopen(darkHair, 40);
    hairSeed = darkHair;

    %% --------------------------------------------------------
    %% Automatic body seeds from detected face/skin region
    faceSeed = imdilate(skinLocal, strel('disk', 3));

    bridgeMask = rectMaskCenter(cx, bb(2) + 1.10*wFace, bridgeWMul*wFace, bridgeHMul*wFace, hc, wc);
    shoulderFG = rectMaskCenter(cx, bb(2) + 1.50*wFace, shoulderWMul*wFace, 0.82*wFace, hc, wc);
    torsoSeed  = rectMaskCenter(cx, bb(2) + 1.95*wFace, 0.90*wFace, 0.70*wFace, hc, wc);
    torsoSearch = rectMaskCenter(cx, bb(2) + 2.20*wFace, 2.55*wFace, 2.60*wFace, hc, wc);

    % Side/strap zones
    strapMask = false(hc, wc);
    if strapLeftMul > 0
        strapMask = strapMask | rectMaskCenter(cx - strapLeftMul*wFace, bb(2) + 2.05*wFace, 0.40*wFace, 2.20*wFace, hc, wc);
    end
    if strapRightMul > 0
        strapMask = strapMask | rectMaskCenter(cx + strapRightMul*wFace, bb(2) + 2.05*wFace, 0.42*wFace, 2.20*wFace, hc, wc);
    end
    if personIdx == 2
        strapMask = rectMaskCenter(cx, bb(2) + 2.95*wFace, 0.55*wFace, 0.90*wFace, hc, wc);
    end

    %% --------------------------------------------------------
    %% Automatic envelope and ROI
    headEnv = ellipseMaskLocal(cx, bb(2) + headCyMul*wFace, headRxMul*wFace, headRyMul*wFace, hc, wc);
    bodyEnv = ellipseMaskLocal(cx, bb(2) + bodyCyMul*wFace, bodyRxMul*wFace, bodyRyMul*wFace, hc, wc);
    envelope = headEnv | bodyEnv | imdilate(bridgeMask, strel('disk', 6));
    roi = imdilate(envelope, strel('disk', 10));

    %% --------------------------------------------------------
    %% Foreground / background seed masks for GrabCut
    foremask = faceSeed | hairSeed | bridgeMask | shoulderFG | torsoSeed;

    backmask = false(hc, wc);

    % Top margin above the head, but leave room for hair
    topBgEnd = max(1, round(bb(2) - 0.45*wFace));
    backmask(1:topBgEnd, :) = true;

    % Side margins
    sideW = max(1, round(0.10*wc));
    backmask(:, 1:sideW) = true;
    backmask(:, max(1, wc-sideW+1):wc) = true;

    % Background beside shoulders
    backmask = backmask | rectMaskCenter(cx - 1.65*wFace, bb(2) + 1.80*wFace, 0.70*wFace, 1.10*wFace, hc, wc);
    backmask = backmask | rectMaskCenter(cx + 1.65*wFace, bb(2) + 1.80*wFace, 0.70*wFace, 1.10*wFace, hc, wc);

    % Do not override foreground
    backmask(foremask) = false;

    %% --------------------------------------------------------
    %% Base GrabCut segmentation
    numSuperpixels = max(400, round((hc*wc) / 2200));
    L = superpixels(Icrop, numSuperpixels);

    BW = grabcut(Icrop, L, roi, foremask, backmask, 'MaximumIterations', 6);
    BW = keepSeedComponents(BW, faceSeed | bridgeMask | torsoSeed);

    %% --------------------------------------------------------
    %% Torso color recovery from automatically sampled torso seed
    Lab = rgb2lab(IcropD);
    Lch = Lab(:,:,1);
    ach = Lab(:,:,2);
    bch = Lab(:,:,3);

    seedL = Lch(torsoSeed);
    seeda = ach(torsoSeed);
    seedb = bch(torsoSeed);

    mu = [mean(seedL), mean(seeda), mean(seedb)];
    sg = [std(seedL)+1e-6, std(seeda)+1e-6, std(seedb)+1e-6];

    D = sqrt(((Lch-mu(1))./sg(1)).^2 + ...
             ((ach-mu(2))./sg(2)).^2 + ...
             ((bch-mu(3))./sg(3)).^2);

    shirtCandidate = D < 4.8;
    shirtCandidate = shirtCandidate & torsoSearch;

    % Require connectivity to torso seed
    marker = imdilate(torsoSeed, strel('disk', 4)) & torsoSearch;
    shirtCandidate = imreconstruct(marker, shirtCandidate | marker);

    % If the sampled shirt is greenish, suppress brighter/more saturated grass on edges
    seedH = mean(H(torsoSeed));
    seedS = mean(S(torsoSeed));
    seedV = mean(V(torsoSeed));

    if seedH > 0.14 && seedH < 0.42
        grassLike = H > 0.18 & H < 0.38 & S > seedS + 0.10 & V > seedV + 0.04;
        edgeRing = shirtCandidate & ~imerode(shirtCandidate, strel('disk', 6));
        shirtCandidate(edgeRing & grassLike & ~foremask) = 0;
    end

    shirtCandidate = bwareaopen(shirtCandidate, 180);

    %% --------------------------------------------------------
    %% Strap / dark side recovery
    darkLike = (V < 0.42) | ((S < 0.35) & (V < 0.60));
    strapCandidate = strapMask & darkLike & imdilate(BW | shirtCandidate | foremask, strel('disk', 10));
    strapCandidate = bwareaopen(strapCandidate, 80);

    %% --------------------------------------------------------
    %% Final local mask
    localMask = BW | shirtCandidate | strapCandidate | foremask;

    % Keep mostly inside the automatic envelope, but always preserve foreground seeds
    localMask = (localMask & imdilate(envelope, strel('disk', 4))) | foremask;

    localMask = imfill(localMask, 'holes');
    localMask = bwareaopen(localMask, 350);
    localMask = imclose(localMask, strel('disk', 4));
    localMask = imopen(localMask, strel('disk', 1));

    % Keep only subject-connected pieces
    localMask = keepSeedComponents(localMask, foremask | torsoSeed | strapCandidate);

    %% Write back to full image
    fullMask = false(rows, cols);
    fullMask(y1:y2, x1:x2) = localMask;
end

function BW = keepSeedComponents(BW, seedMask)
    CC = bwconncomp(BW);
    out = false(size(BW));

    for k = 1:CC.NumObjects
        pix = CC.PixelIdxList{k};
        if any(seedMask(pix))
            out(pix) = true;
        end
    end

    BW = out;
end

function BW = rectMaskCenter(cx, cy, w, h, rows, cols)
    x1 = max(1, round(cx - w/2));
    x2 = min(cols, round(cx + w/2));
    y1 = max(1, round(cy - h/2));
    y2 = min(rows, round(cy + h/2));

    BW = false(rows, cols);
    if x1 <= x2 && y1 <= y2
        BW(y1:y2, x1:x2) = true;
    end
end

function BW = ellipseMaskLocal(cx, cy, rx, ry, rows, cols)
    [X, Y] = meshgrid(1:cols, 1:rows);
    BW = ((X - cx).^2 ./ (rx.^2 + eps) + (Y - cy).^2 ./ (ry.^2 + eps)) <= 1;
end